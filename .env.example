# ==============================================================================
# EduManagement Environment Configuration Template
# Instructions: Copy this file to '.env' and update sensitive values for production.
# Command: cp .env.example .env
# ==============================================================================

# ----------------- Database Configuration (PostgreSQL 16) -----------------
POSTGRES_DB=edumanagement
POSTGRES_USER=edumanager
# CAUTION: Change to a strong, high-entropy password in production
POSTGRES_PASSWORD=ChangeThisSecretPostgresPassword123!
POSTGRES_PORT=5432

# ----------------- Redis Cache & Session Store -----------------
# CAUTION: Change to a strong password in production
REDIS_PASSWORD=ChangeThisSecretRedisPassword123!
REDIS_PORT=6379

# ----------------- JWT Security Configuration -----------------
# Generate with: openssl rand -hex 64
JWT_SECRET=b65406d4e8c158d6014451ca99285bb247e1933f7c9e0d19f4a0b73c4d7e98a12b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c
# Access Token Lifetime in milliseconds (default: 15 minutes = 900000 ms)
JWT_ACCESS_EXPIRATION_MS=900000
# Refresh Token Lifetime in milliseconds (default: 7 days = 604800000 ms)
JWT_REFRESH_EXPIRATION_MS=604800000

# ----------------- Service Ports -----------------
FRONTEND_PORT=80
BACKEND_PORT=8080

# ----------------- JVM Memory & Performance -----------------
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC
